{
  "info": {
    "name": "ReNew API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "testId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Reject notebook creation without authentication",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/notebooks",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"manufacturer\": \"DEMO\",\n  \"type\": \"Authorization test\",\n  \"display\": 14.0,\n  \"memory\": 4096,\n  \"harddisk\": 256,\n  \"videocontroller\": \"Integrated\",\n  \"price\": 100,\n  \"processorid\": 1,\n  \"opsystemid\": 1,\n  \"pieces\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Anonymous notebook creation returns 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List notebooks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notebooks",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List notebooks returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get notebook 1",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notebooks/1",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get notebook 1 returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST ",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/notebooks",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"manufacturer\": \"DEMO\",\n  \"type\": \"API test\",\n  \"display\": 14.0,\n  \"memory\": 4096,\n  \"harddisk\": 256,\n  \"videocontroller\": \"Integrated\",\n  \"price\": 100,\n  \"processorid\": 1,\n  \"opsystemid\": 1,\n  \"pieces\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Created\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"testId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /{{testId}}",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/notebooks/{{testId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"manufacturer\": \"DEMO\",\n  \"type\": \"API test\",\n  \"display\": 14.0,\n  \"memory\": 4096,\n  \"harddisk\": 256,\n  \"videocontroller\": \"Integrated\",\n  \"price\": 100,\n  \"processorid\": 1,\n  \"opsystemid\": 1,\n  \"pieces\": 3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update notebook returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /{{testId}}",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/notebooks/{{testId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete notebook returns 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}